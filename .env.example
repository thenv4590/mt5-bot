# Global dry-run override. If set, this takes precedence over config.json's
# top-level "dryRun" value. Leave unset to use config.json.
# DRY_RUN=true

# MT5 password per strategy: MT5_PASSWORD_<STRATEGY_KEY_UPPERCASED>
# The strategy key comes from config.json -> strategies.<key>
MT5_PASSWORD_ETH_STRATEGY_01=your-mt5-password-here

# Path to the MT5 terminal executable. Defaults to the standard Windows
# install location (C:/Program Files/MetaTrader 5/terminal64.exe) if unset.
# MT5_TERMINAL_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# Path to the log file (optional, defaults to logs/app.log)
LOG_FILE=logs/app.log

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Telegram bot token, used only as a FALLBACK for strategies whose
# config.json "telegram" block does not set its own "botToken" (get a
# token from @BotFather). Not needed if every strategy sets botToken
# directly in config.json.
# TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenXXXXXXXXXXXXXXXXXXX

# Optional: fallback bot token for one specific strategy only.
# TELEGRAM_BOT_TOKEN_ETH_STRATEGY_01=987654321:AAAnotherBotTokenXXXXXXXXXXX
